# Live Polymarket is the default — market discovery and order books are public
# and need no key. Copy this to .env.local and you're pointed at the real thing.

# Uncomment to run entirely on bundled sample markets instead: no network, no
# wallet, no orders. Useful for UI work, offline development and demos.
# FIXTURE_MODE=1

# Seatbelt on stake size, enforced server-side. Raise deliberately.
MAX_BET_USD=100

# How many markets to pull from Gamma before screening, and how many order
# books to read per pull. Higher = better selection, slower pulls.
DISCOVERY_LIMIT=250
MAX_BOOKS_PER_SPIN=60

# Only override these if you're pointing at a mock or a different environment.
# GAMMA_HOST=https://gamma-api.polymarket.com
# CLOB_HOST=https://clob.polymarket.com
