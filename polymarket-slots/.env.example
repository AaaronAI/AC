# Run entirely on bundled sample markets: no network, no wallet, no real orders.
# Great for developing the UI and for a demo. Unset (or set to 0) to go live.
FIXTURE_MODE=1

# Seatbelt on bet size, enforced server-side. Raise deliberately.
MAX_BET_USD=100

# How many markets to pull from Gamma before screening, and how many order
# books to read per spin. Higher = better selection, slower spins.
DISCOVERY_LIMIT=250
MAX_BOOKS_PER_SPIN=60

# Only override these if you're pointing at a mock or a different environment.
# GAMMA_HOST=https://gamma-api.polymarket.com
# CLOB_HOST=https://clob.polymarket.com
